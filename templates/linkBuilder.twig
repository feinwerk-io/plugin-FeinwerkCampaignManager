<div class="fwcmp-platformstatus-mount" vue-entry="FeinwerkCampaignManager.PlatformStatus"></div>
<div class="fwcmp-mount"
     vue-entry="FeinwerkCampaignManager.LinkBuilder"
     id-site="{{ idSite|e('html_attr') }}"
     can-write="{{ canWrite ? 'true' : 'false' }}"
     {% if feedback %}feedback="{{ feedback|json_encode|e('html_attr') }}"{% endif %}
     {% if promo %}promo="{{ promo|json_encode|e('html_attr') }}"{% endif %}
     site-url="{{ siteUrl|e('html_attr') }}"></div>
